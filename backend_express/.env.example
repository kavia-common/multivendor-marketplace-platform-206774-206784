# Backend Express environment variables (scaffolding)
# Note: This project template uses REACT_APP_* vars even for backend container.

# Server
REACT_APP_PORT=3001
REACT_APP_NODE_ENV=development
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/

# Auth (REQUIRED for /api/v1/auth/* routes)
REACT_APP_JWT_SECRET=change-me-in-production
REACT_APP_JWT_ISSUER=backend_express
REACT_APP_JWT_AUDIENCE=multivendor-marketplace
REACT_APP_JWT_EXPIRES_IN=1h

# Database (PostgreSQL) - provided by platform for database_postgresql container
# Preferred:
POSTGRES_URL=postgresql://user:password@host:port/dbname
# Alternatively (only if POSTGRES_URL is not provided):
POSTGRES_USER=appuser
POSTGRES_PASSWORD=secret
POSTGRES_DB=myapp
POSTGRES_PORT=5432
